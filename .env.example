NEXT_PUBLIC_API_BASE_URL=https://preprod.mstoo.co.in
NEXT_PUBLIC_APP_NAME=MSTOO
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Razorpay web checkout. If omitted, the app uses keys from /customer/config when present.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Google Maps JS (backend place APIs are used by default).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
